# ── Frontend (Vite) — préfixe VITE_ obligatoire, ces valeurs sont PUBLIQUES ──
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_SUPABASE_VIDEO_BUCKET=videos

# Cloudflare Turnstile — anti-bot des formulaires publics (inscription event,
# adhésion, partenariat, don, newsletter).
# Clé de SITE (publique). Vide = Turnstile désactivé, les formulaires marchent
# quand même (l'Edge Function n'exige alors pas le token).
# Créer un widget : dash.cloudflare.com → Turnstile → Add site.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# ── Edge Functions (Supabase secrets, JAMAIS exposés au navigateur) ──
# supabase secrets set NOM=valeur
BREVO_API_KEY=xkeysib-...
SENDER_EMAIL=contact@exemple.org
SENDER_NAME=ONG DDB
APP_URL=https://exemple.org
# Clé SECRÈTE Turnstile (pas la clé de site) — vérifie le token côté serveur.
# Vide = la fonction verify-submission n'exige pas de token (déploiement progressif).
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
